flowchart LR
    subgraph Linear Algebra
        A[Vectors and matrices] --> B[Dot products and norms]
        B --> C[Matrix multiply = layer]
    end
    subgraph Calculus
        D[Loss function] --> E[Partial derivatives]
        E --> F[Gradient]
    end
    subgraph Probability
        G[Distributions] --> H[Expectation and variance]
    end
    C --> I[Model output]
    F --> J[Gradient descent update]
    H --> K[Loss as negative log-likelihood]
    I --> J
    K --> J
    J --> L[Lower loss next step]
