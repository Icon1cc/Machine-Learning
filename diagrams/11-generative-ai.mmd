flowchart TD
    A[Training data distribution] --> B{Model family}
    B -- Likelihood --> C[Autoregressive: predict next token]
    B -- Latent --> D[VAE: encode -> sample -> decode]
    B -- Adversarial --> E[GAN: generator vs discriminator]
    B -- Denoising --> F[Diffusion: add noise then learn to reverse]
    C --> G[Sample new content]
    D --> G
    E --> G
    F --> G
    G --> H[Condition on prompt / class / image]
    H --> I[Evaluate: FID, human pref, perplexity]
    I --> J{Quality and diversity ok?}
    J -- No --> A
    J -- Yes --> K[Deploy with safety filters]
